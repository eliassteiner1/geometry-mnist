   "source": [
    "import numpy as np\n",
    "from geometry_mnist.plotly.plots import plot_pts\n",
    "from geometry_mnist.paths import ROOT\n",
    "\n",
    "pts = np.load(ROOT/\"data/knot_relaxed.npy\")\n",
    "plot_pts(pts, kos_len=0.01)\n"
   ]
